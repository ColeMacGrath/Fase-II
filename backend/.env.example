# Variables de entorno del backend Agente OS (Capa Nube).
# Copia este archivo como backend/.env y ajusta los valores.
# backend/.env está en .gitignore y en .dockerignore: nunca se sube al repositorio ni se copia a la imagen.

# Llave de la API de Claude. Créala en https://platform.claude.com/settings/keys
# Si se deja vacía, el backend arranca con el planificador determinista.
ANTHROPIC_API_KEY=

# Modelo de Claude y nivel de esfuerzo (low, medium, high).
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low
CLAUDE_TIMEOUT_S=60

# 1 fuerza el planificador determinista aunque exista una llave. Útil para pruebas sin costo.
CLAUDE_MOCK=1

# Token compartido entre la app de macOS y el backend, enviado en el encabezado X-Agent-Token.
# Vacío desactiva la verificación. En la nube se recomienda definirlo.
AGENT_TOKEN=

# Límites de entrada.
MAX_TASK_CHARS=2000
MAX_SCREEN_CHARS=20000
MAX_IMAGE_BYTES=5242880
